# =============================================================================
# ТверьНефтеРегион — переменные окружения
# Скопируйте в .env.local и заполните реальными значениями
# =============================================================================

# --- Сайт ---
# Локально: localhost. На Vercel (Production): https://tvernefteregion.ru (без www)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ТверьНефтеРегион

# --- Адрес компании (опционально, для верхней панели Header) ---
NEXT_PUBLIC_COMPANY_ADDRESS=

# --- Бренд / медиа (опционально, для CMS-замены) ---
# NEXT_PUBLIC_BRAND_LOGO_SRC=/brand/logo.png
# NEXT_PUBLIC_HERO_IMAGE_SRC=/images/hero/transport.jpg

# --- Контакты (переопределяют src/config/contact-defaults.ts) ---
# Явное отключение: NEXT_PUBLIC_CONTACT_PHONE_ENABLED=false
NEXT_PUBLIC_CONTACT_PHONE=+79040085012
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+7 (904) 008-50-12
NEXT_PUBLIC_CONTACT_EMAIL=tver-neft-region@bk.ru
NEXT_PUBLIC_CONTACT_TELEGRAM=https://t.me/Molotoff69
NEXT_PUBLIC_CONTACT_MAX=https://max.ru/u/f9LHodD0cOLnmKSi09-fDD16VIPxPLzT9-8aWdqrSXghmtnexGJvLPjB7Qc
NEXT_PUBLIC_CONTACT_WHATSAPP=79040085012


# --- Доставка заявок с форм (Resend) ---
# Обязательно в Vercel Production / Preview:
RESEND_API_KEY=
# Опционально (по умолчанию forms@tvernefteregion.ru → tver-neft-region@bk.ru):
# RESEND_FROM=forms@tvernefteregion.ru
# RESEND_TO=tver-neft-region@bk.ru

# --- Яндекс Метрика (опционально) ---
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Источник контента (local | payload) ---
# CONTENT_SOURCE=local

# --- Payload CMS (будущее подключение) ---
# DATABASE_URI=postgresql://user:password@localhost:5432/tver_nefte_region
# PAYLOAD_SECRET=

# --- Режим разработки ---
# NODE_ENV=development
