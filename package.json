    "react-hook-form": "^7.55.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.3",
